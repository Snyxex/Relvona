{
  "name": "ai-customer-support-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/scripts/ensureVectorExtension.ts && drizzle-kit push && tsx src/scripts/ensureApplicationSchema.ts && tsx src/scripts/ensureWidgetIntegrationSchema.ts && tsx src/scripts/ensureIngestionSchema.ts && tsx src/scripts/migrateLegacyPasswordHashes.ts && tsx src/scripts/migratePlatformRoles.ts && tsx src/scripts/migrateLegacyApiKeys.ts && tsx src/scripts/ensureVectorIndexes.ts && tsx src/scripts/enableRls.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test:security": "tsx src/tests/security.test.ts",
    "test:tenant-isolation": "tsx src/tests/tenantIsolation.integration.test.ts",
    "test:auth-regression": "tsx src/tests/authRegression.integration.test.ts",
    "test:tools": "tsx src/tests/toolRegistry.test.ts",
    "test:streaming": "tsx src/tests/streaming.test.ts",
    "test:ingestion": "tsx src/tests/ingestion.test.ts",
    "test:github": "tsx src/tests/githubIssueService.test.ts",
    "test:active-directory": "tsx src/tests/activeDirectoryService.test.ts",
    "test:authorization": "tsx src/tests/authorizationMiddleware.test.ts",
    "test:ingestion-integration": "tsx src/tests/ingestion.integration.test.ts",
    "test:ci-auth": "npm run build && npm run test:security && npm run test:authorization && npm run test:tenant-isolation && npm run test:auth-regression",
    "secrets:rotate": "tsx src/scripts/rotateEncryptionKey.ts",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.2",
    "bullmq": "^5.81.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.20.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.12",
    "ldapts": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.8",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
