# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_SECRET=replace-with-a-different-long-random-secret

# PostgreSQL with the pgvector extension enabled
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/ai_support_db
REDIS_URL=redis://localhost:6379
PORT=8080
NODE_ENV=development

# Comma-separated dashboard origins; do not use * in production.
CORS_ORIGIN=http://localhost:3000

# Configure at least one provider, or add keys through the admin dashboard.
OPENAI_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
