NODE_ENV=development
PORT=8080

# Database
DATABASE_URL=postgresql://supportai_app:replace-with-app-password@localhost:5432/ai_support_db
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-admin-password@localhost:5432/ai_support_db
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
DATABASE_REQUEST_POOL_MAX=20
DATABASE_REQUEST_POOL_MIN=0
DATABASE_SCHEDULING_LOCK_POOL_MAX=2
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_MAX_LIFETIME_SECONDS=1800

# Redis / queues
REDIS_URL=redis://localhost:6379
INGESTION_WORKER_CONCURRENCY=2

# Public app URLs / CORS
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Object/blob storage. RustFS is the default self-hosted S3-compatible target.
# When the backend runs outside Docker, localhost:9000 is the RustFS S3 API.
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_PROVIDER=rustfs
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# URL used only for presigned links sent to browsers. In production this must be HTTPS.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=supportai
# RustFS access keys should be non-default and uppercase alphanumeric.
OBJECT_STORAGE_ACCESS_KEY=SUPPORTAILOCAL
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-storage-secret
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
# Optional app-managed bucket CORS for direct browser uploads. Comma-separated exact origins; never use * in production.
OBJECT_STORAGE_CORS_ALLOWED_ORIGINS=http://localhost:3000
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
OBJECT_STORAGE_CONNECT_TIMEOUT_MS=5000
OBJECT_STORAGE_REQUEST_TIMEOUT_MS=30000
OBJECT_STORAGE_MAX_RETRIES=3
# Production internal HTTP endpoints require an explicit opt-in. Keep false for public/external endpoints.
OBJECT_STORAGE_ALLOW_INSECURE_HTTP=false
STORAGE_CLEANUP_SWEEP_MS=60000

# Optional customer portal.
CUSTOMER_PORTAL_ENABLED=false
PORTAL_TOKEN_SECRET=replace-with-a-separate-long-random-secret
PORTAL_PUBLIC_URL=http://localhost:3000/customer-portal
PORTAL_MAGIC_LINK_WEBHOOK_URL=
PORTAL_MAGIC_LINK_WEBHOOK_SECRET=

# Durable outbound webhooks. Private/internal destinations remain blocked by
# default to prevent SSRF. Enable only for trusted self-hosted deployments.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_DELIVERY_SWEEP_MS=5000

# Direct integration delivery and inbound Zendesk webhook processing.
INTEGRATION_SYNC_SWEEP_MS=5000
INTEGRATION_SYNC_STALE_MS=600000
INTEGRATION_INBOUND_SWEEP_MS=5000
INTEGRATION_INBOUND_STALE_MS=600000
# Reject signed Zendesk webhook requests outside this replay window.
ZENDESK_WEBHOOK_MAX_SKEW_MS=300000

# Durable Google/Microsoft calendar reconciliation. Booking state is written
# locally first; failed provider mutations are retried by the worker.
CALENDAR_SYNC_SWEEP_MS=5000
CALENDAR_SYNC_STALE_MS=600000
CALENDAR_SYNC_MAX_ATTEMPTS=8

# Conversation lifecycle
CONVERSATION_AUTO_CLOSE_SWEEP_MS=60000

# Knowledge recrawl
KNOWLEDGE_RECRAWL_SWEEP_MS=60000

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=30000

# Infisical (production)
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=production
INFISICAL_DOMAIN=
