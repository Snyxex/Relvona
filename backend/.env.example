# Local development only. Production values are injected at startup by Infisical.
BETTER_AUTH_SECRET=replace-with-a-separate-32-character-minimum-random-secret
BETTER_AUTH_URL=http://localhost:8080
ENCRYPTION_SECRET_CURRENT=replace-with-a-different-long-random-secret
ENCRYPTION_KEY_ID=v1
# Set only for the bounded key-rotation window, then remove after `npm run secrets:rotate`.
# WIDGET_SESSION_SECRET_PREVIOUS=
# ENCRYPTION_SECRET_PREVIOUS=
# ENCRYPTION_PREVIOUS_KEY_ID=

# PostgreSQL with the pgvector extension enabled
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/ai_support_db
# In production, DATABASE_URL must use the non-owner application login below, subject to RLS.
# DATABASE_ADMIN_URL is available only to the one-shot migration service (schema, RLS, role bootstrap).
# DATABASE_URL=postgres://supportai_app:replace@postgres:5432/support
# DATABASE_ADMIN_URL=postgres://support-admin:replace@postgres:5432/support
# DATABASE_APP_USER=supportai_app
# DATABASE_APP_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://localhost:6379
PORT=8080
NODE_ENV=development
# Core pool: workers, explicit transactions and non-request workloads.
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
# Dedicated HTTP request pool. Request-scoped connections are reused for all DB
# queries in one HTTP request and are reset before being returned to the pool.
DATABASE_REQUEST_POOL_MAX=20
DATABASE_REQUEST_POOL_MIN=0
# Dedicated small pool used only for PostgreSQL advisory locks that serialize
# booking mutations. Keep this smaller than the normal application pool.
DATABASE_SCHEDULING_LOCK_POOL_MAX=2
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_MAX_LIFETIME_SECONDS=1800
AI_REQUEST_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=65000
AI_MAX_RETRIES=2
AI_CIRCUIT_COOLDOWN_MS=30000
SHUTDOWN_TIMEOUT_MS=30000
JSON_BODY_LIMIT=128kb
URLENCODED_BODY_LIMIT=64kb
METRICS_TOKEN=replace-with-a-long-random-token
WIDGET_SESSION_SECRET=replace-with-a-long-random-secret
VISITOR_IDENTITY_SECRET=replace-with-a-separate-long-random-secret

# Optional customer portal.
CUSTOMER_PORTAL_ENABLED=false
PORTAL_TOKEN_SECRET=replace-with-a-separate-long-random-secret
PORTAL_PUBLIC_URL=http://localhost:3000/customer-portal
PORTAL_MAGIC_LINK_WEBHOOK_URL=
PORTAL_MAGIC_LINK_WEBHOOK_SECRET=

# Durable outbound webhooks. Private/internal destinations remain blocked by
# default to prevent SSRF. Enable only for trusted self-hosted deployments.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_DELIVERY_SWEEP_MS=5000

# Direct integration delivery and inbound Zendesk webhook processing.
INTEGRATION_SYNC_SWEEP_MS=5000
INTEGRATION_SYNC_STALE_MS=600000
INTEGRATION_INBOUND_SWEEP_MS=5000
INTEGRATION_INBOUND_STALE_MS=600000
# Reject signed Zendesk webhook requests outside this replay window.
ZENDESK_WEBHOOK_MAX_SKEW_MS=300000

# Durable Google/Microsoft calendar reconciliation. Booking state is written
# locally first; failed provider mutations are retried by the worker.
CALENDAR_SYNC_SWEEP_MS=5000
CALENDAR_SYNC_STALE_MS=600000
CALENDAR_SYNC_MAX_ATTEMPTS=8

# Calendar OAuth. Register callback URLs as:
#   http://localhost:8080/api/v1/calendar-oauth/google/callback
#   http://localhost:8080/api/v1/calendar-oauth/microsoft/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Use a tenant ID for single-tenant Entra apps, or common for multitenant/personal flows.
MICROSOFT_CALENDAR_TENANT_ID=common

# Comma-separated dashboard origins; do not use * in production.
CORS_ORIGIN=http://localhost:3000

OPENAI_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

LOCAL_AI_BASE_URL=
LOCAL_AI_ALLOW_PRIVATE_NETWORKS=false
ACTIVE_DIRECTORY_ALLOW_PRIVATE_NETWORKS=false